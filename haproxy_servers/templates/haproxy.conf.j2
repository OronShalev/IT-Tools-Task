global
    log         127.0.0.1 local2
    chroot      /var/lib/haproxy
    pidfile     /var/run/haproxy.pid
    maxconn     4000
    user        haproxy
    group       haproxy
    # run in foreground — systemd manages the process
    stats socket /run/haproxy/stats mode 600 level admin
    ssl-default-bind-ciphers PROFILE=SYSTEM
    ssl-default-server-ciphers PROFILE=SYSTEM


defaults
    mode                    http
    log                     global
    option                  httplog
    option                  dontlognull
    option http-server-close
    option forwardfor       except 127.0.0.0/8
    option                  redispatch
    retries                 3
    timeout http-request    10s
    timeout queue           1m
    timeout connect         10s
    timeout client          1m
    timeout server          1m
    timeout http-keep-alive 10s
    timeout check           10s
    maxconn                 3000

frontend http_front
  bind *:80
  default_backend webservers

frontend https_front
  bind *:443
  mode http
  default_backend webservers

backend webservers
  mode http
  balance roundrobin
{% for host in groups['nginx_web_servers'] %}
  server {{ host }} {{ hostvars[host]['ansible_host'] }}:80 check
{% endfor %}